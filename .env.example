# Environment variables for LiveBoard
# Copy this to .env and fill in your values

# Database
DB_NAME=liveboard
DB_USER=liveboard
DB_PASSWORD=liveboardpass
DB_ROOT_PASSWORD=rootpassword

# JWT (use a secure random string in production, min 32 chars)
JWT_SECRET=liveboard-change-this-secret-in-production-min-32-chars

# Frontend (for local dev without Docker)
VITE_API_URL=http://localhost:8080
